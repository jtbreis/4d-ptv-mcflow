FROM ubuntu:24.04

# Install Python and C++ build essentials
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3 \
        python3-venv \
        python3-pip \
        build-essential \
        g++ \
        libhdf5-dev \
        && rm -rf /var/lib/apt/lists/*


# Copy the code from the host into the container
COPY . /workspaces/4d-ptv-mcflow
WORKDIR /workspaces/4d-ptv-mcflow

RUN cd STMCpp && make

# Optional: create a venv
RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --upgrade pip \
    && /opt/venv/bin/pip install -r /workspaces/4d-ptv-mcflow/requirements.txt

RUN cd PTVcalib && /opt/venv/bin/pip install .
RUN /opt/venv/bin/pip install .

ENV PATH="/opt/venv/bin:$PATH"

# Set python3 as default python
RUN ln -sf /usr/bin/python3 /usr/bin/python

COPY docker/docker-entrypoint-umask.sh /usr/local/bin/docker-entrypoint-umask.sh
COPY docker/setup-shareddata-user.sh /tmp/setup-shareddata-user.sh
RUN chmod +x /usr/local/bin/docker-entrypoint-umask.sh \
    && bash /tmp/setup-shareddata-user.sh && rm /tmp/setup-shareddata-user.sh
USER appuser
ENTRYPOINT ["/usr/local/bin/docker-entrypoint-umask.sh", "python3", "Processing Steps/complete_workflow.py"]