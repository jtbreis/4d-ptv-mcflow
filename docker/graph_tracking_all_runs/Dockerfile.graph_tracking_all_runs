# Graph-based 4-frame tracking (all runs). Requires 4BE-ETI + graph_tracking.
# Runs: Processing Tools/run_graph_tracking_all_runs.py
# Lighter than legacy tracking image: no STMCpp build.

FROM ubuntu:24.04

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3 python3-venv python3-pip build-essential libhdf5-dev \
        && rm -rf /var/lib/apt/lists/*

COPY . /workspaces/4d-ptv-mcflow
WORKDIR /workspaces/4d-ptv-mcflow

RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --upgrade pip \
    && /opt/venv/bin/pip install -r /workspaces/4d-ptv-mcflow/requirements-docker.txt
RUN if [ -d 4BE-ETI ] && [ -f 4BE-ETI/pyproject.toml ]; then /opt/venv/bin/pip install -e ./4BE-ETI; fi
RUN if [ -d Post-Processing ] && [ -f Post-Processing/pyproject.toml ]; then /opt/venv/bin/pip install -e ./Post-Processing; fi
RUN if [ -d graph_tracking ] && [ -f graph_tracking/pyproject.toml ]; then /opt/venv/bin/pip install -e ./graph_tracking; fi

ENV PATH="/opt/venv/bin:$PATH"
RUN ln -sf /usr/bin/python3 /usr/bin/python

COPY docker/docker-entrypoint-umask.sh /usr/local/bin/docker-entrypoint-umask.sh
COPY docker/setup-shareddata-user.sh /tmp/setup-shareddata-user.sh
RUN chmod +x /usr/local/bin/docker-entrypoint-umask.sh \
    && bash /tmp/setup-shareddata-user.sh && rm /tmp/setup-shareddata-user.sh
USER appuser
ENTRYPOINT ["/usr/local/bin/docker-entrypoint-umask.sh", "python3", "Processing Tools/run_graph_tracking_all_runs.py"]
CMD ["--case", "TTI_opposing_gravity"]
