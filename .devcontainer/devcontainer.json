{
    "build": {
        "dockerfile": "Dockerfile",
        "context": "."
    },

    "features": {
        "python": {
            "version": "3.10"
        }
    },
    "postCreateCommand": "sudo apt-get update && sudo apt-get install -y build-essential g++ libhdf5-dev && pip install -r requirements.txt && (getent group shareddata >/dev/null || sudo groupadd -g 1500 shareddata) && sudo usermod -aG shareddata vscode",
    "customizations": {
        "vscode": {
        "extensions": [
            "ms-python.python",
            "ms-python.vscode-pylance",
            "ms-toolsai.jupyter",
            "analytic-signal.preview-tiff",
            "mhutchie.git-graph"
        ],
        "python.formatting.provider": "autopep8",
        "editor.formatOnSave": true,
        "settings": {
            "terminal.integrated.shell.linux": "/bin/bash"
        }
        }
    },
    "remoteUser": "root",
    "containerUser": "root",
    "updateRemoteUserUID": false,
    "mounts": [
        "source=~/notebook/,target=/workspaces/4d-ptv-mcflow/notebook,type=bind,consistency=cached",
        "source=/mnt/ssd/,target=/workspaces/4d-ptv-mcflow/data,type=bind,consistency=cached",
        "source=/mnt/raid/,target=/workspaces/4d-ptv-mcflow/raw_data,type=bind,consistency=cached",
        "source=/mnt/raid1/,target=/workspaces/4d-ptv-mcflow/processed_data,type=bind,consistency=cached"
    ]
}
