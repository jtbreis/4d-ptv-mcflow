{
    // Use Ubuntu as the base image
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu",

    // Features to install Python
    "features": {
        "python": {
            "version": "3.10"
        },
        "ghcr.io/mathworks/devcontainer-features/matlab:0": {
            "release": "r2024a",
            "installMatlabProxy": true,
            "products": "MATLAB Image_Processing_Toolbox"
        }
    },
    "containerEnv": {
        "MWI_APP_PORT": "8888"
    },
    "forwardPorts": [8888],
    "postCreateCommand": "pip install -r requirements.txt",
    "customizations": {
        "vscode": {
        "extensions": [
            "ms-python.python",
            "ms-python.vscode-pylance",
            "ms-toolsai.jupyter",
            "analytic-signal.preview-tiff",
            "mhutchie.git-graph"
        ],
        "python.formatting.provider": "autopep8",
        "editor.formatOnSave": true,
        "settings": {
            "terminal.integrated.shell.linux": "/bin/bash"
        }
        }
    },
    "mounts": [
        "source=/mnt/ssd/,target=/workspaces/4d-ptv-mcflow/data,type=bind,consistency=cached",
        "source=/mnt/raid/,target=/workspaces/4d-ptv-mcflow/raw_data,type=bind,consistency=cached",
        "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,consistency=cached"
    ]
}